{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "eternity-ui-infobar",
    "version": "0.9.0",
    "authors": ["Jaime"],
    "license": "MIT",
    "wowlua": "^0.13"
  },
  "addon": {
    "name": "EternityUI_InfoBar",
    "title": "Eternity Info Bar",
    "notes": "Eternity module: a small bar with the time, FPS, latency and gold."
  },
  "addon-dependencies": {
    "required": ["EternityUI"]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "load-order": ["src/Generated/Options.lua", "src/Locale.lua", "src/Perf.lua", "src/PerfTab.lua", "src/ContentTab.lua", "src/InfoBar.lua"]
  },
  "test": {
    "blizzard-ui": true,
    "addons": ["../../../../dist/dev/EternityUI"]
  },
  "check": {
    "globals": ["EternityUI"]
  }
}
