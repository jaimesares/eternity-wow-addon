{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "eternity-ui-automation",
    "version": "0.9.0",
    "authors": ["Jaime"],
    "license": "MIT",
    "wowlua": "^0.13"
  },
  "addon": {
    "name": "EternityUI_Automation",
    "title": "Eternity Automation",
    "notes": "Eternity module: small automations, each with its own switch.",
    "saved-variables": ["EternityUIAutomationDB"]
  },
  "addon-dependencies": {
    "required": ["EternityUI"]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "load-order": [
      "src/Generated/Options.lua",
      "src/Locale.lua",
      "src/Core.lua",
      "src/Merchant.lua",
      "src/Social.lua",
      "src/Death.lua",
      "src/Quests.lua",
      "src/Loot.lua",
      "src/Cinematics.lua",
      "src/Automation.lua"
    ]
  },
  "test": {
    "blizzard-ui": true,
    "addons": ["../../../../dist/dev/EternityUI"]
  },
  "check": {
    "globals": ["EternityUI", "EternityUIAutomationDB"]
  }
}
