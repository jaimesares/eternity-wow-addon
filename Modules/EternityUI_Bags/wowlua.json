{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "eternity-ui-bags",
    "version": "0.9.0",
    "authors": ["Jaime"],
    "license": "MIT",
    "wowlua": "^0.13"
  },
  "addon": {
    "name": "EternityUI_Bags",
    "title": "Eternity Bags",
    "notes": "Eternity module: bags and bank, and what every character carries.",
    "saved-variables": ["EternityUIBagsDB"]
  },
  "addon-dependencies": {
    "required": ["EternityUI"]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "load-order": ["src/Generated/Options.lua", "src/Locale.lua", "src/Inventory.lua", "src/Supplies.lua", "src/Locks.lua", "src/Viewer.lua", "src/Bags.lua"]
  },
  "test": {
    "blizzard-ui": true,
    "addons": ["../../../../dist/dev/EternityUI"]
  },
  "check": {
    "globals": ["EternityUI", "EternityUIBagsDB", "ContainerFrameContainer", "BankFrame"]
  }
}
