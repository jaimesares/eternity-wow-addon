{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "eternity-ui-portraits",
    "version": "0.9.0",
    "authors": ["Jaime"],
    "license": "MIT",
    "wowlua": "^0.13"
  },
  "addon": {
    "name": "EternityUI_Portraits",
    "title": "Eternity Portraits",
    "notes": "Eternity module: a theme's class portraits over Blizzard's unit frames."
  },
  "addon-dependencies": {
    "required": ["EternityUI"]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "load-order": ["src/Generated/Options.lua", "src/Portraits.lua"]
  },
  "test": {
    "blizzard-ui": true,
    "addons": ["../../../../dist/dev/EternityUI"]
  },
  "check": {
    "globals": ["EternityUI"]
  }
}
