{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "eternity-ui-loot",
    "version": "0.9.0",
    "authors": ["Jaime"],
    "license": "MIT",
    "wowlua": "^0.13"
  },
  "addon": {
    "name": "EternityUI_Loot",
    "title": "Eternity Loot",
    "notes": "Eternity module: a themed loot window that can open at the mouse, a searchable history of what you looted and a movable spot for group rolls.",
    "saved-variables": ["EternityUILootDB"]
  },
  "addon-dependencies": {
    "required": ["EternityUI"]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "load-order": [
      "src/Generated/Options.lua",
      "src/Locale.lua",
      "src/Recorder.lua",
      "src/Window.lua",
      "src/History.lua",
      "src/Rolls.lua",
      "src/Loot.lua"
    ]
  },
  "test": {
    "blizzard-ui": true,
    "addons": ["../../../../dist/dev/EternityUI"]
  },
  "check": {
    "globals": [
      "EternityUI",
      "EternityUILootDB",
      "SOUNDKIT"
    ]
  }
}
