{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "eternity-ui-experience",
    "version": "0.9.0",
    "authors": ["Jaime"],
    "license": "MIT",
    "wowlua": "^0.13"
  },
  "addon": {
    "name": "EternityUI_Experience",
    "title": "Eternity Experience",
    "notes": "Eternity module: an experience bar with charts.",
    "saved-variables": ["EternityUIExperienceDB"]
  },
  "addon-dependencies": {
    "required": ["EternityUI"]
  },
  "flavors": {
    "camelot": {}
  },
  "build": {
    "load-order": [
      "src/Generated/Options.lua",
      "src/Locale.lua",
      "src/Data.lua",
      "src/Bar.lua",
      "src/Charts.lua",
      "src/Experience.lua"
    ]
  },
  "test": {
    "blizzard-ui": true,
    "addons": ["../../../../dist/dev/EternityUI"]
  },
  "check": {
    "globals": [
      "EternityUI",
      "EternityUIExperienceDB",
      "MainStatusTrackingBarContainer",
      "SecondaryStatusTrackingBarContainer"
    ]
  }
}
